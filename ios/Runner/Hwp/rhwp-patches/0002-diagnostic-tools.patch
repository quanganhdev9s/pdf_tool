+++ b/examples/diag_seg_width.rs
@@ -0,0 +1,20 @@
+// Lineseg mà Hancom lưu có mang bề rộng riêng cho từng dòng không?
+//
+// Nếu các dòng cạnh ảnh có `segment_width` hẹp hơn, thì việc chữ né ảnh đã nằm
+// sẵn trong dữ liệu — reflow chỉ cần dùng lại thay vì tính lại từ hình học.
+use rhwp::document_core::DocumentCore;
+
+fn main() {
+    let path = std::env::args().nth(1).expect("cần .hwp");
+    let para: usize = std::env::args().nth(2).and_then(|s| s.parse().ok()).unwrap_or(7);
+    let bytes = std::fs::read(&path).expect("read");
+    let core = DocumentCore::from_bytes(&bytes).expect("parse");
+    let p = &core.document().sections[0].paragraphs[para];
+    println!("đoạn {para}: {} lineseg", p.line_segs.len());
+    for (i, ls) in p.line_segs.iter().enumerate() {
+        println!(
+            "  [{i:>2}] text_start={:<5} vpos={:<7} column_start={:<7} segment_width={:<7}",
+            ls.text_start, ls.vertical_pos, ls.column_start, ls.segment_width
+        );
+    }
+}
diff --git a/examples/diag_wrap_blast.rs b/examples/diag_wrap_blast.rs
new file mode 100644
index 00000000..e52b51a8
--- /dev/null
+++ b/examples/diag_wrap_blast.rs
@@ -0,0 +1,40 @@
+// Bán kính ảnh hưởng: bao nhiêu đoạn có lineseg với bề rộng KHÁC NHAU giữa các
+// dòng? Chỉ những đoạn đó mới đi vào đường mới; phần còn lại giữ nguyên hành vi.
+use rhwp::document_core::DocumentCore;
+
+fn main() {
+    let mut tot = 0usize;
+    let mut varying = 0usize;
+    let mut files = 0usize;
+    for path in std::env::args().skip(1) {
+        let Ok(bytes) = std::fs::read(&path) else { continue };
+        let Ok(core) = DocumentCore::from_bytes(&bytes) else { continue };
+        files += 1;
+        let mut f_var = 0usize;
+        let mut f_tot = 0usize;
+        for sec in core.document().sections.iter() {
+            for p in sec.paragraphs.iter() {
+                if p.line_segs.len() < 2 { continue; }
+                f_tot += 1;
+                let mut w: Vec<(i32, i32)> = Vec::new();
+                for seg in p.line_segs.iter() {
+                    if seg.segment_width <= 0 { continue; }
+                    match w.last_mut() {
+                        Some((v, x)) if *v == seg.vertical_pos => *x = (*x).max(seg.segment_width),
+                        _ => w.push((seg.vertical_pos, seg.segment_width)),
+                    }
+                }
+                if w.windows(2).any(|q| q[0].1 != q[1].1) { f_var += 1; }
+            }
+        }
+        tot += f_tot;
+        varying += f_var;
+        if f_var > 0 {
+            let name = path.rsplit('/').next().unwrap_or(&path).to_string();
+            println!("  {:<46} {}/{} doan co be rong thay doi", name.chars().take(40).collect::<String>(), f_var, f_tot);
+        }
+    }
+    println!();
+    println!("TONG: {varying}/{tot} doan nhieu dong ({:.2}%) tren {files} tep di vao duong moi",
+             100.0 * varying as f64 / tot.max(1) as f64);
+}
