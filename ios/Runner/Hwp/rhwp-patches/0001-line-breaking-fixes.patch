+//! 폰트별 줄 높이 비율 (line_height / font_size).
+//!
+//! # 배경
+//!
+//! `LineSeg.line_height` 는 폰트 크기가 아니라 폰트의 세로 메트릭에서 나온다:
+//!
+//! ```text
+//! line_height = font_size * (hhea.ascender - hhea.descender + hhea.lineGap) / unitsPerEm
+//! ```
+//!
+//! 한컴이 저장한 실제 파일에서 측정한 값이 이 식과 일치한다:
+//!
+//! | 폰트 | 식이 주는 값 | 저장본 실측 |
+//! |---|---|---|
+//! | Arial (asc 1854, desc -434, gap 67, em 2048) | 1.1499 | 1.1500 |
+//! | 한글 계열 (asc 800, desc -200, gap 0, em 1000) | 1.0000 | 1.0000 |
+//!
+//! 종전 구현은 이 비율을 항상 1.0 으로 두었다. 한글 폰트 문서는 우연히 맞았지만
+//! Arial 본문 문서는 편집 직후 줄 간격이 13% 줄어들고 쪽수가 함께 줄었다.
+//!
+//! # 기본값이 1.0 인 이유
+//!
+//! `font_metrics_data.rs` 는 자동 생성물이라 세로 메트릭이 없다. 표에 없는 폰트는
+//! 종전 동작(1.0)을 그대로 유지해 회귀를 만들지 않는다. `font-metric-gen` 이
+//! hhea 세로 메트릭까지 뽑도록 확장되면 이 표는 생성물로 대체될 수 있다.
+
+/// 표에 없는 폰트의 기본 비율 — 종전 동작과 동일하다.
+pub const DEFAULT_LINE_HEIGHT_RATIO: f64 = 1.0;
+
+/// 표에 없는 폰트의 기본 baseline 비율 — 종전 하드코딩 값과 동일하다.
+pub const DEFAULT_BASELINE_RATIO: f64 = 0.85;
+
+/// (폰트 이름, ascender, descender, lineGap, unitsPerEm)
+///
+/// 값은 각 폰트의 hhea 테이블 공표값이다. 이름 비교는 대소문자를 무시한다.
+const HHEA_METRICS: &[(&str, i32, i32, i32, i32)] = &[
+    ("Arial", 1854, -434, 67, 2048),
+    ("Arial Black", 2254, -634, 0, 2048),
+    ("Arial Narrow", 1854, -434, 67, 2048),
+    ("Helvetica", 1577, -471, 0, 2048),
+    ("Times New Roman", 1825, -443, 87, 2048),
+    ("Courier New", 1705, -615, 0, 2048),
+    ("Verdana", 2059, -430, 0, 2048),
+    ("Tahoma", 2049, -423, 0, 2048),
+    ("Georgia", 1878, -449, 0, 2048),
+    ("Calibri", 1536, -512, 442, 2048),
+    ("Cambria", 1946, -486, 0, 2048),
+    ("Segoe UI", 2210, -514, 0, 2048),
+];
+
+fn lookup(font_family: &str) -> Option<(i32, i32, i32, i32)> {
+    let name = font_family.trim();
+    if name.is_empty() {
+        return None;
+    }
+    HHEA_METRICS
+        .iter()
+        .find(|(font, ..)| name.eq_ignore_ascii_case(font))
+        .filter(|(_, _, _, _, em)| *em > 0)
+        .map(|(_, asc, desc, gap, em)| (*asc, *desc, *gap, *em))
+}
+
+/// 폰트 이름으로 줄 높이 비율을 구한다. 모르는 폰트는
+/// [`DEFAULT_LINE_HEIGHT_RATIO`].
+pub fn line_height_ratio(font_family: &str) -> f64 {
+    match lookup(font_family) {
+        Some((asc, desc, gap, em)) => (asc - desc + gap) as f64 / em as f64,
+        None => DEFAULT_LINE_HEIGHT_RATIO,
+    }
+}
+
+/// `baseline_distance / line_height` — 줄 상단에서 baseline 까지의 비율.
+///
+/// 한컴 저장본 실측(Arial, line_height 1265): baseline 1032 → 0.8158.
+/// `(ascender + lineGap) / (ascender - descender + lineGap)` = 0.8157 로 일치한다.
+/// 종전 하드코딩 0.85 는 이 폰트에서 baseline 을 43 HWPUNIT 아래로 밀었다.
+pub fn baseline_ratio(font_family: &str) -> f64 {
+    match lookup(font_family) {
+        Some((asc, desc, gap, _)) => {
+            let lh = asc - desc + gap;
+            if lh <= 0 {
+                DEFAULT_BASELINE_RATIO
+            } else {
+                (asc + gap) as f64 / lh as f64
+            }
+        }
+        None => DEFAULT_BASELINE_RATIO,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn arial_matches_hancom_stored_line_height() {
+        // 한컴 저장본 실측 1.1500 — 소수 셋째 자리까지 일치해야 한다.
+        assert!((line_height_ratio("Arial") - 1.15).abs() < 0.001);
+        // 이름 대소문자는 무시한다.
+        assert!((line_height_ratio("ARIAL") - 1.15).abs() < 0.001);
+    }
+
+    #[test]
+    fn unknown_font_keeps_previous_behaviour() {
+        assert_eq!(line_height_ratio("함초롬바탕"), DEFAULT_LINE_HEIGHT_RATIO);
+        assert_eq!(line_height_ratio(""), DEFAULT_LINE_HEIGHT_RATIO);
+    }
+}
